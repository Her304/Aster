# Set this in Vercel to use durable Neon Postgres storage.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional local override. When DATABASE_URL is absent, Aster uses SQLite.
ASTER_DB_PATH=./data/aster.db

# Sign-in codes for survey owners are emailed through Resend (resend.com).
# EMAIL_FROM must use a domain you have verified with Resend.
# Without these, local development prints codes to the server console instead,
# and production refuses to send them.
RESEND_API_KEY=
EMAIL_FROM=Aster <hello@your-domain.example>

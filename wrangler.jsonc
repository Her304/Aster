{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Must match the Worker's name in the Cloudflare dashboard.
	"name": "aster",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-11-13",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "aster"
		}
	],
	// Next.js image optimisation through Cloudflare Images.
	"images": {
		"binding": "IMAGES"
	},
	// Lets non-production branches deploy as Worker Previews.
	"previews": {},
	// Plain-text variables live here, because every deploy replaces the
	// Worker's plain-text variables with this list. Secrets (RESEND_API_KEY,
	// DATABASE_URL, ADMIN_TOKEN) stay in the dashboard; deploys keep those.
	"vars": {
		// Sender for sign-in codes and notifications (domain verified in Resend).
		"EMAIL_FROM": "Aster <hello-noreply@astereve.net>"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	}
}
